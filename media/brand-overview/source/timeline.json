          "end": 64.5555
        }
      ],
      "principle": 1
    },
    {
      "id": "principle-2",
      "scene": "principle",
      "text": "第二，事实优先与独立分析。用户、专家、政府与研究者，都采用相同的证据标准。",
      "start": 65.074,
      "end": 74.266,
      "captions": [
        {
          "text": "第二，事实优先与独立分析。",
          "start": 65.174,
          "end": 68.2115
        },
        {
          "text": "用户、专家、政府与研究者，都采用相同的证据标准。",
